{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        @supports (-webkit-appearance: -apple-pay-button) {
            .apple-pay-button {
                display: inline-block;
                -webkit-appearance: -apple-pay-button;
            }
            .apple-pay-button-black {
                -apple-pay-button-style: black;
            }
            .apple-pay-button-white {
                -apple-pay-button-style: white;
            }
            .apple-pay-button-white-with-line {
                -apple-pay-button-style: white-outline;
            }
        }


        @supports not (-webkit-appearance: -apple-pay-button) {
            .apple-pay-button {
                display: inline-block;
                background-size: 100% 60%;
                background-repeat: no-repeat;
                background-position: 50% 50%;
                border-radius: 5px;
                padding: 0px;
                box-sizing: border-box;
                min-width: 200px;
                min-height: 32px;
                max-height: 64px;
            }
            .apple-pay-button-black {
                background-image: -webkit-named-image(apple-pay-logo-white);
                background-color: black;
            }
            .apple-pay-button-white {
                background-image: -webkit-named-image(apple-pay-logo-black);
                background-color: white;
            }
            .apple-pay-button-white-with-line {
                background-image: -webkit-named-image(apple-pay-logo-black);
                background-color: white;
                border: .5px solid black;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div id="app">
        <div class="container">
            <div class="row">
                <div class="col-12 text-center">
                    <button class="apple-pay-button apple-pay-button-black" onclick="payWithApplePay()"></button>
                </div>
            </div>
            <div class="row">
                <div class="col-12">
                    <pre id="debug-dump" style="width: 90%; min-height: 800px; margin: 50px auto; border: 1px solid grey;"></pre>
                </div>
            </div>
        </div>
    </div>

    <script>
        const $debugDump = document.querySelector('#debug-dump')

        function writeDebug(message, data) {
            if (!message) message = '';
            if (!data) data = '';

            $debugDump.innerHTML += 'Message: ' + message + '\n'
            $debugDump.innerHTML += JSON.stringify(data, undefined, '  ')
            $debugDump.innerHTML += '\n\n=====\n\n'
        }

        function payWithApplePay() {
            const session = new ApplePaySession(3, {
                countryCode: 'AT',
                currencyCode: 'EUR',
                supportedNetworks: ['visa', 'masterCard', 'amex', 'discover'],
                merchantCapabilities: ['supports3DS'],
                total: { label: 'PAYONE Apple Pay Prototypers', amount: '10.00' },
            })

            session.onvalidatemerchant = (evt) => {
                fetch('{{ path('create_apple_pay_session') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ validation_url: 'https://apple-pay-gateway.apple.com' }),
                    cache: 'no-cache',
                }).then(response => {
                    if (response.status !== 201) {
                        console.error('Error while creating Apple Pay session.')
                        writeDebug('ERROR: Failed to create Apple Pay session.', response)
                        return;
                    }

                    response.json().then(merchantSession => {
                        console.log('Got merchant session from Apple Pay.', merchantSession)
                        writeDebug('SUCCESS: Created Apple Pay session.', merchantSession)
                        session.completeMerchantValidation(merchantSession)
                    })
                })
            }

            session.onpaymentauthorized = (evt) => {
                writeDebug('SUCCESS: Payment was authorized.', evt.payment)

                fetch('{{ path('create_apple_pay_payment') }}', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: evt.payment.token,
                        // todo: make use of shippingDetails, billingDetails
                    }),
                    cache: 'no-cache',
                }).then(response => {
                    if (response.status !== 201) {
                        console.error('Error while finishing Apple Pay payment with PSP.')
                        writeDebug('ERROR: Failed communication with PSP.', response)
                        return;
                    }

                    response.json().then(data => {
                        console.log('Successfully finished Apple Pay payment with PSP.', data)
                        writeDebug('SUCCESS: Successfully finished Apple Pay payment with PSP.', data)
                        session.completePayment({
                            status: ApplePaySession.STATUS_SUCCESS,
                            errors: [],
                        })
                    })
                })
            }

            session.begin()
        }

        writeDebug('Click the Apple Pay button to initiate the demo payment.');
    </script>
{% endblock %}
