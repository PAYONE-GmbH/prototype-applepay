services:
  apldemo:
    container_name: apldemo_app_${CONTAINER_NAME_SUFFIX}
    build:
      context: .
      dockerfile: ./Dockerfile
    image: apldemo
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.${TRAEFIK_ROUTER_SERVICE}.entrypoints=web"
      - "traefik.http.routers.${TRAEFIK_ROUTER_SERVICE}.rule=Host(`${TRAEFIK_HOST_RULE_SERVICE}`)"
      - "traefik.http.services.${TRAEFIK_ROUTER_SERVICE}.loadbalancer.server.port=80"
    volumes:
      - ./app:/app
    networks:
      - default
      - traefik
    depends_on:
      - apldemo_php

  apldemo_php:
    container_name: apldemo_php_${CONTAINER_NAME_SUFFIX}
    image: php:8.1-alpine
    restart: unless-stopped
    stdin_open: true
    tty: true
    command: /bin/sh
    volumes:
      - ./app:/app
    networks:
      - default

networks:
  traefik:
    external: true